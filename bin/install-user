#!/usr/bin/env bash
set -euo pipefail

INSTALL_SOURCE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
INSTALL_HOME=${HOME:?HOME must be set}
INSTALL_BASE="$INSTALL_HOME/.local/share/server-doctor"
INSTALL_LAUNCHER="$INSTALL_HOME/server-doctor"

case "$INSTALL_BASE" in
  /|/usr|/etc|/var|/home|/root)
    printf 'Refusing unsafe install directory: %s\n' "$INSTALL_BASE" >&2
    exit 2
    ;;
esac

if [[ -e $INSTALL_LAUNCHER && ! -L $INSTALL_LAUNCHER ]]; then
  printf 'Cannot install launcher: %s already exists and is not a symlink.\n' "$INSTALL_LAUNCHER" >&2
  exit 2
fi

INSTALL_STAMP="$(date -u +%Y%m%dT%H%M%SZ).$$"
INSTALL_RELEASE="$INSTALL_BASE/releases/$INSTALL_STAMP"
INSTALL_LINK_TMP="$INSTALL_BASE/.launcher.$INSTALL_STAMP"

cleanup_install_link() {
  if [[ -L ${INSTALL_LINK_TMP:-} ]]; then
    rm -f -- "$INSTALL_LINK_TMP"
  fi
}
trap cleanup_install_link EXIT

install -d -m 0755 \
  "$INSTALL_RELEASE/bin" \
  "$INSTALL_RELEASE/collectors" \
  "$INSTALL_RELEASE/config" \
  "$INSTALL_RELEASE/lib"
install -m 0755 "$INSTALL_SOURCE_ROOT/bin/server-doctor" "$INSTALL_RELEASE/bin/server-doctor"
install -m 0755 "$INSTALL_SOURCE_ROOT"/collectors/*.sh "$INSTALL_RELEASE/collectors/"
install -m 0644 "$INSTALL_SOURCE_ROOT/config/defaults.conf" "$INSTALL_RELEASE/config/defaults.conf"
install -m 0644 "$INSTALL_SOURCE_ROOT"/lib/*.sh "$INSTALL_RELEASE/lib/"
install -m 0644 "$INSTALL_SOURCE_ROOT/README.md" "$INSTALL_RELEASE/README.md"

ln -s "$INSTALL_RELEASE/bin/server-doctor" "$INSTALL_LINK_TMP"
mv -f -- "$INSTALL_LINK_TMP" "$INSTALL_LAUNCHER"
chmod 0755 "$INSTALL_BASE" "$INSTALL_BASE/releases" "$INSTALL_RELEASE"

printf 'Installed server-doctor runtime: %s\n' "$INSTALL_RELEASE"
printf 'Launcher: %s\n' "$INSTALL_LAUNCHER"
printf 'Run: %s doctor --profile standard --since 24h\n' "$INSTALL_LAUNCHER"
